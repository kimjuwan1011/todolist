rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인 없이 공용 데이터(연습용)
    // - 이 앱은 /todos/yyyy-mm-dd 문서만 사용합니다.
    // - 완전 공개 규칙이므로 공개 배포 시에는 인증/권한을 추가하세요.
    function isDateId(id) {
      // RE2 호환성을 위해 \d 대신 [0-9] 사용
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /todos/{dateId} {
      allow read, write: if isDateId(dateId);
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

